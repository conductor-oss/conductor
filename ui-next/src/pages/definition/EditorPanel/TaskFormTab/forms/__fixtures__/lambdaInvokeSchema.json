{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "functionName": {
      "description": "Function name or ARN",
      "type": "string"
    },
    "invocationType": {
      "default": "RequestResponse",
      "description": "Synchronous invocation only",
      "enum": ["RequestResponse"],
      "oneOf": [{ "const": "RequestResponse", "title": "Sync" }],
      "type": "string"
    },
    "payload": {
      "description": "Payload as JSON string",
      "type": "string"
    },
    "qualifier": {
      "description": "Optional function version or alias; omit to invoke the unqualified function",
      "type": "string"
    }
  },
  "required": ["functionName", "payload"],
  "type": "object"
}
