{
  "name": "deep_research_brief",
  "description": "Creates a bounded, source-linked deep research brief using provider-native web search.",
  "version": 1,
  "schemaVersion": 2,
  "timeoutSeconds": 360,
  "timeoutPolicy": "TIME_OUT_WF",
  "inputParameters": [
    "question",
    "audience"
  ],
  "tasks": [
    {
      "name": "research_and_synthesize",
      "taskReferenceName": "research_and_synthesize",
      "type": "LLM_CHAT_COMPLETE",
      "inputParameters": {
        "llmProvider": "openai",
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "message": "Conduct bounded deep research using web search. Return markdown with an executive summary, competing evidence, uncertainty, and a Sources section with URLs."
          },
          {
            "role": "user",
            "message": "Question: ${workflow.input.question}\nAudience: ${workflow.input.audience}"
          }
        ],
        "webSearch": true,
        "temperature": 0.2,
        "maxTokens": 2400
      },
      "taskDefinition": {
        "name": "research_and_synthesize",
        "retryCount": 2,
        "retryLogic": "EXPONENTIAL_BACKOFF",
        "retryDelaySeconds": 5,
        "responseTimeoutSeconds": 120,
        "timeoutSeconds": 300,
        "timeoutPolicy": "TIME_OUT_WF",
        "rateLimitPerFrequency": 10,
        "rateLimitFrequencyInSeconds": 60,
        "concurrentExecLimit": 3
      }
    }
  ],
  "outputParameters": {
    "brief": "${research_and_synthesize.output.result}",
    "tokens": "${research_and_synthesize.output.tokenUsed}"
  }
}
