{
  "name": "tool_calling_incident_agent",
  "description": "Uses an LLM to choose from an allowlisted worker tool, then summarizes the result.",
  "version": 1,
  "schemaVersion": 2,
  "timeoutSeconds": 240,
  "timeoutPolicy": "TIME_OUT_WF",
  "inputParameters": [
    "incidentId",
    "question"
  ],
  "tasks": [
    {
      "name": "choose_tool",
      "taskReferenceName": "choose_tool",
      "type": "LLM_CHAT_COMPLETE",
      "inputParameters": {
        "llmProvider": "openai",
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "message": "You are an incident assistant. The only available tool is lookup_incident(incidentId). Return JSON only with tool and incidentId."
          },
          {
            "role": "user",
            "message": "Incident: ${workflow.input.incidentId}. Question: ${workflow.input.question}"
          }
        ],
        "temperature": 0,
        "maxTokens": 120,
        "jsonOutput": true
      },
      "taskDefinition": {
        "name": "choose_tool",
        "retryCount": 2,
        "retryLogic": "EXPONENTIAL_BACKOFF",
        "retryDelaySeconds": 2,
        "responseTimeoutSeconds": 30,
        "timeoutSeconds": 60,
        "timeoutPolicy": "TIME_OUT_WF",
        "concurrentExecLimit": 10
      }
    },
    {
      "name": "allowlisted_tool_dispatch",
      "taskReferenceName": "allowlisted_tool_dispatch",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "tool",
      "inputParameters": {
        "tool": "${choose_tool.output.result.tool}"
      },
      "decisionCases": {
        "lookup_incident": [
          {
            "name": "lookup_incident",
            "taskReferenceName": "lookup_incident",
            "type": "SIMPLE",
            "inputParameters": {
              "incidentId": "${choose_tool.output.result.incidentId}"
            }
          }
        ]
      },
      "defaultCase": [
        {
          "name": "reject_unknown_tool",
          "taskReferenceName": "reject_unknown_tool",
          "type": "TERMINATE",
          "inputParameters": {
            "terminationStatus": "FAILED",
            "workflowOutput": {
              "reason": "Tool is not allowlisted"
            }
          }
        }
      ]
    },
    {
      "name": "summarize_tool_result",
      "taskReferenceName": "summarize_tool_result",
      "type": "LLM_CHAT_COMPLETE",
      "inputParameters": {
        "llmProvider": "openai",
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "message": "Give a factual incident answer. Do not perform a write."
          },
          {
            "role": "user",
            "message": "Question: ${workflow.input.question}\nTool result: ${lookup_incident.output}"
          }
        ],
        "temperature": 0.1,
        "maxTokens": 500
      },
      "taskDefinition": {
        "name": "summarize_tool_result",
        "retryCount": 2,
        "retryLogic": "EXPONENTIAL_BACKOFF",
        "retryDelaySeconds": 2,
        "responseTimeoutSeconds": 30,
        "timeoutSeconds": 60,
        "timeoutPolicy": "TIME_OUT_WF",
        "concurrentExecLimit": 10
      }
    }
  ],
  "outputParameters": {
    "tool": "${choose_tool.output.result.tool}",
    "evidence": "${lookup_incident.output}",
    "answer": "${summarize_tool_result.output.result}"
  }
}
