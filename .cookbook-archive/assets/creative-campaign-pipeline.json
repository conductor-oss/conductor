{
  "name": "creative_campaign_asset_pipeline",
  "description": "Generates image and video campaign assets after human approval of the prompt and brand constraints.",
  "version": 1,
  "schemaVersion": 2,
  "timeoutSeconds": 900,
  "timeoutPolicy": "TIME_OUT_WF",
  "inputParameters": [
    "prompt",
    "campaignId"
  ],
  "tasks": [
    {
      "name": "approve_creative_brief",
      "taskReferenceName": "approve_creative_brief",
      "type": "HUMAN",
      "inputParameters": {
        "campaignId": "${workflow.input.campaignId}",
        "prompt": "${workflow.input.prompt}"
      }
    },
    {
      "name": "route_creative_approval",
      "taskReferenceName": "route_creative_approval",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "approved",
      "inputParameters": {
        "approved": "${approve_creative_brief.output.approved}"
      },
      "decisionCases": {
        "true": [
          {
      "name": "generate_image",
      "taskReferenceName": "generate_image",
      "type": "GENERATE_IMAGE",
      "inputParameters": {
        "llmProvider": "openai",
        "model": "dall-e-3",
        "prompt": "${workflow.input.prompt}",
        "width": 1024,
        "height": 1024,
        "n": 1
      },
      "taskDefinition": {
        "name": "generate_image",
        "retryCount": 1,
        "retryLogic": "EXPONENTIAL_BACKOFF",
        "retryDelaySeconds": 10,
        "responseTimeoutSeconds": 90,
        "timeoutSeconds": 180,
        "timeoutPolicy": "TIME_OUT_WF",
        "rateLimitPerFrequency": 5,
        "rateLimitFrequencyInSeconds": 60,
        "concurrentExecLimit": 2
      }
    },
    {
      "name": "generate_video",
      "taskReferenceName": "generate_video",
      "type": "GENERATE_VIDEO",
      "inputParameters": {
        "llmProvider": "openai",
        "model": "sora-2",
        "prompt": "Animate this approved campaign concept: ${workflow.input.prompt}",
        "inputImage": "${generate_image.output.url}",
        "duration": 8,
        "size": "1280x720"
      },
      "taskDefinition": {
        "name": "generate_video",
        "retryCount": 1,
        "retryLogic": "EXPONENTIAL_BACKOFF",
        "retryDelaySeconds": 10,
        "responseTimeoutSeconds": 120,
        "timeoutSeconds": 600,
        "timeoutPolicy": "TIME_OUT_WF",
        "rateLimitPerFrequency": 2,
        "rateLimitFrequencyInSeconds": 60,
        "concurrentExecLimit": 1
      }
          }
        ]
      },
      "defaultCase": [
        {
          "name": "creative_rejected",
          "taskReferenceName": "creative_rejected",
          "type": "TERMINATE",
          "inputParameters": {
            "terminationStatus": "COMPLETED",
            "workflowOutput": {
              "status": "rejected"
            }
          }
        }
      ]
    }
  ],
  "outputParameters": {
    "image": "${generate_image.output.url}",
    "video": "${generate_video.output.media}"
  }
}
