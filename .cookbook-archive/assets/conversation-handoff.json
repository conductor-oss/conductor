{
  "name": "conversation_handoff_and_escalation",
  "description": "Summarizes a conversation and pauses for a human responder before any follow-up action.",
  "version": 1,
  "schemaVersion": 2,
  "timeoutSeconds": 86400,
  "timeoutPolicy": "TIME_OUT_WF",
  "inputParameters": [
    "conversation",
    "customerId"
  ],
  "tasks": [
    {
      "name": "prepare_handoff",
      "taskReferenceName": "prepare_handoff",
      "type": "LLM_CHAT_COMPLETE",
      "inputParameters": {
        "llmProvider": "openai",
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "system",
            "message": "Create a concise support handoff: issue, evidence, requested resolution, and risk. Do not promise an outcome."
          },
          {
            "role": "user",
            "message": "${workflow.input.conversation}"
          }
        ],
        "temperature": 0.1,
        "maxTokens": 500
      },
      "taskDefinition": {
        "name": "prepare_handoff",
        "retryCount": 2,
        "retryLogic": "EXPONENTIAL_BACKOFF",
        "retryDelaySeconds": 2,
        "responseTimeoutSeconds": 30,
        "timeoutSeconds": 60,
        "timeoutPolicy": "TIME_OUT_WF",
        "concurrentExecLimit": 10
      }
    },
    {
      "name": "human_escalation",
      "taskReferenceName": "human_escalation",
      "type": "HUMAN",
      "inputParameters": {
        "customerId": "${workflow.input.customerId}",
        "handoff": "${prepare_handoff.output.result}"
      }
    }
  ],
  "outputParameters": {
    "handoff": "${prepare_handoff.output.result}",
    "humanDecision": "${human_escalation.output}"
  }
}
