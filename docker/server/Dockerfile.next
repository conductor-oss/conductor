#
# conductor:server-next - Conductor Server + ui-next
#
# Identical to Dockerfile but uses ui-next (Vite/pnpm/React 18) instead of ui.
# Produces the :next Docker tag alongside the existing :latest.
#
# Ports:
#   8080 - Conductor API + Swagger (Spring Boot)
#   5000 - ui-next (nginx)
#
# Two modes:
#   Default:        Builds JAR and UI from source (local dev / docker compose)
#   PREBUILT=true:  Skips builds, uses pre-built artifacts (CI multi-arch)
#

# The builder stages below run on Debian + Temurin 25 (JDK). The shipped runtime (final stage)
# runs on the Alpine Temurin 25 JRE pinned to the same 25.0.5+8 release.
FROM debian:trixie-slim AS java-base

ARG TEMURIN_VERSION=25.0.5.0.0+8-0
ARG CA_CERTIFICATES_MIN_VERSION=20250419+deb13u1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge "$CA_CERTIFICATES_MIN_VERSION" \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public -o /etc/apt/keyrings/adoptium.asc \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.asc] https://packages.adoptium.net/artifactory/deb trixie main" > /etc/apt/sources.list.d/adoptium.list \
    && rm -rf /var/lib/apt/lists/*

FROM java-base AS jdk

RUN apt-get update \
    && apt-get install -y --no-install-recommends "temurin-25-jdk=${TEMURIN_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

# ===========================================================================================================
# 0. Server builder stage
# ===========================================================================================================
FROM jdk AS builder

ARG PREBUILT=false
ARG INDEXING_BACKEND=elasticsearch8

LABEL maintainer="Orkes OSS <oss@orkes.io>"

COPY . /conductor
WORKDIR /conductor

RUN if [ "$PREBUILT" = "true" ]; then \
      rm -rf server/build/libs && mkdir -p server/build/libs && \
      cp docker/server/libs/conductor-server.jar server/build/libs/conductor-server-boot.jar && \
      echo "Using pre-built server JAR"; \
    else \
      ./gradlew build -x test -x spotlessCheck -x shadowJar \
        -PindexingBackend=${INDEXING_BACKEND} \
        -Dorg.gradle.jvmargs=-Xmx2g \
        --no-daemon --no-parallel; \
    fi

# ===========================================================================================================
# 1. UI builder stage  (ui-next — pnpm + Vite)
# ===========================================================================================================
FROM node:22 AS ui-builder

ARG PREBUILT=false

LABEL maintainer="Orkes OSS <oss@orkes.io>"

RUN corepack enable

COPY ui-next /conductor/ui-next
WORKDIR /conductor/ui-next

RUN if [ "$PREBUILT" = "false" ]; then \
      pnpm install && NODE_OPTIONS=--max-old-space-size=4096 pnpm build; \
    else \
      echo "Using pre-built ui-next/dist assets"; \
    fi

# ===========================================================================================================
# 2. Final stage
# ===========================================================================================================
# Alpine base to shed the OS-level CVEs that debian:stable-slim carried: perl
# (CVE-2026-13221 / CVE-2026-57432), libssh2 (CVE-2026-58050), and an nginx that debian-slim
# could not patch past 1.26.3 (CVE-2026-60005). The temurin JRE ships in the base image, so the
# only package we add is nginx. The healthcheck uses busybox wget (built in) instead of curl,
# which also removes curl's libcurl/libssh2 chain from the image entirely.
#
# Pinned to the same 25.0.5+8 Temurin release as the Debian builder stage above (Alpine tag
# format 25.0.5_8) so the shipped JRE is a known, reproducible, patched build.
FROM eclipse-temurin:25.0.5_8-jre-alpine

LABEL maintainer="Orkes OSS <oss@orkes.io>"

RUN apk add --no-cache nginx ca-certificates \
    && rm -f /etc/nginx/http.d/default.conf \
    && mkdir -p /run/nginx

# DO NOT REMOVE WHILE WE ARE RUNNING ALPINE!
# grpc-java (bundled via conductor-grpc-server) is not officially supported on Alpine/musl and
# recommends a glibc-based image. Its native netty bits can segfault the JVM at load time under
# musl. gcompat + libunwind provide the glibc-compat shims; startup.sh LD_PRELOADs them around the
# java invocation only (not nginx/busybox). Without these packages the preload paths would not
# exist and the dynamic loader would error.
RUN apk add --no-cache gcompat libunwind

FROM runtime AS final

RUN mkdir -p /app/config /app/logs /app/libs

COPY docker/server/bin /app
COPY docker/server/config /app/config
COPY --from=builder /conductor/server/build/libs/*boot*.jar /app/libs/conductor-server.jar

# ui-next dist served by nginx on port 5000
WORKDIR /usr/share/nginx/html
RUN rm -rf ./*
COPY --from=ui-builder /conductor/ui-next/dist .
COPY docker/server/nginx/nginx.conf /etc/nginx/http.d/default.conf

RUN chmod +x /app/startup.sh

# Uses 127.0.0.1 (not localhost): busybox wget resolves localhost to ::1 first and does not fall
# back to IPv4 the way curl did, so localhost would fail against the IPv4-bound server.
HEALTHCHECK --interval=60s --timeout=30s --retries=10 CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1

CMD [ "/app/startup.sh" ]
ENTRYPOINT [ "/bin/sh"]
